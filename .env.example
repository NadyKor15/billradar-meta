# Meta Model API key (dev.meta.ai -> API keys). Never commit the real value.
MODEL_API_KEY=
# Set to 1 to call the live API. Anything else replays recorded responses.
BILLRADAR_LIVE=0
# Hard stop for live spend, in USD, counted from what each call reserves (runs/meta-spend.jsonl).
META_SPEND_CAP_USD=5
# The second reading of every sheet, and the read-only second look on Muse Wonder.
BILLRADAR_SECOND_READ=1
BILLRADAR_WONDER_REVIEW=1
# Finding a hospital's own policy on its site: BILLRADAR_POLICY_FINDER=1 and a Tavily key.
BILLRADAR_POLICY_FINDER=0
TAVILY_API_KEY=
